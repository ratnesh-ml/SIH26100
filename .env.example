# ==============================================================================
# VigilBid (SIH26100) — Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the system:
#   cp .env.example .env
#
# IMPORTANT FOR PRODUCTION:
# 1. Replace SECRET_KEY with a cryptographically secure 64-character hex string.
# 2. Generate a new FERNET_KEY using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 3. Update PostgreSQL credentials and restricted CORS origins.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="VigilBid (SIH26100)"
ENVIRONMENT=development                  # development | test | production
DEBUG=true                              # true | false
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Security & Cryptographic Keys
# ------------------------------------------------------------------------------
# JWT Signing Secret (HS256) - Min 64 chars in production
SECRET_KEY=dev-secret-key-change-in-production-64chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=480         # 8 hours session expiry

# Fernet 32-byte URL-safe base64 key for encrypting sensitive PII (PAN/GSTIN) at rest
FERNET_KEY=uE_3m_9sF9yKz6T-Yh1N9P0wZ7vL5k4j2h1g8f7e6d4=

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of trusted origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vigilbid
POSTGRES_PORT=5432

# Async SQLAlchemy connection URL (used by FastAPI backend & worker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vigilbid

# Sync SQLAlchemy connection URL (used by Alembic migrations & sync scripts)
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/vigilbid

# ------------------------------------------------------------------------------
# 4. Storage & Content-Addressable Filestore
# ------------------------------------------------------------------------------
# Root storage directory for ingested immutable PDF packages and page caches
STORAGE_DIR=./data/storage

# ------------------------------------------------------------------------------
# 5. OCR & Document Processing
# ------------------------------------------------------------------------------
PRIMARY_OCR=paddleocr                   # paddleocr | tesseract | fallback
FALLBACK_OCR=tesseract                  # tesseract | easyocr | fallback
OCR_DPI=150                             # Standard raster DPI for thumbnail and OCR
MAX_PARALLEL_OCR_WORKERS=4              # ThreadPoolExecutor worker count for multi-page scans

# ------------------------------------------------------------------------------
# 6. Procurement Copilot & Regulatory LLM
# ------------------------------------------------------------------------------
LLM_ENABLED=false                       # Set to true to enable procurement assistant
LLM_PROVIDER=ollama                     # ollama | openai | none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------------------------------------------
# 7. Mock Government Registries & Demo Settings
# ------------------------------------------------------------------------------
REGISTRY_PROVIDER=mock                  # mock | real
DEMO_AIR_GAPPED=true                    # Disables external outbound HTTP network calls
MOCK_REGISTRIES_DIR=./seed/mock_fixtures

# ------------------------------------------------------------------------------
# 8. Frontend Client (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
